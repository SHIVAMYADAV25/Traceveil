# Copy to .env.local and adjust. .env.production (committed) supplies build-time placeholders only.

MONGODB_URI=mongodb://127.0.0.1:27017/traceveilX
NEXT_PUBLIC_API_URL=http://localhost:8000
INTELLIGENCE_SERVICE_URL=http://localhost:8002
TAKEDOWN_SERVICE_URL=http://localhost:8003
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional: magic link email
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=

# Community (separate service, own database). In development the browser calls it directly.
# In production, route a path on your domain to the service and set this to /api/community
NEXT_PUBLIC_COMMUNITY_API_URL=http://localhost:8004/api/community
