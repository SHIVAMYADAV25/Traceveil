# ---------------- LOCAL DEVELOPMENT: copy to apps/web/.env.local ----------------
MONGODB_URI=mongodb://127.0.0.1:27017/traceveilX
NEXT_PUBLIC_API_URL=http://localhost:8000
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
INTELLIGENCE_SERVICE_URL=http://localhost:8002
TAKEDOWN_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_COMMUNITY_API_URL=http://localhost:8004/api/community
GROQ_API_KEY=
# NEXT_PUBLIC_LOGO_DEV_KEY=
# NEXT_PUBLIC_QUICK_EXIT_URL=https://www.google.com   # optional; defaults to this site's home page

# ---------------- PRODUCTION (set these in Vercel -> Settings -> Environment Variables) ----------------
# NEXT_PUBLIC_* are baked in at build time: change one, then REDEPLOY.
# MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/traceveilX?retryWrites=true&w=majority
# NEXT_PUBLIC_API_URL=https://traceveil-analysis.onrender.com
# ANALYSIS_SERVICE_URL=https://traceveil-analysis.onrender.com
# INTELLIGENCE_SERVICE_URL=https://traceveil-intelligence.onrender.com
# TAKEDOWN_SERVICE_URL=https://traceveil-takedown.onrender.com
# NEXT_PUBLIC_COMMUNITY_API_URL=https://traceveil-community.onrender.com/api/community
# GROQ_API_KEY=gsk_...
# (NEXTAUTH_URL / NEXTAUTH_SECRET are no longer used: auth was removed.)
