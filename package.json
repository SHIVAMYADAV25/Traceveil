{
  "name": "impic-algoforge26-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"web,analysis,intel,takedown\" --prefix-colors \"blue,green,yellow,magenta\" \"pnpm --filter @traceveil/web dev\" \"pnpm --filter @traceveil/analysis dev\" \"pnpm --filter @traceveil/intelligence dev\" \"pnpm --filter @traceveil/takedown dev\"",
    "dev:web": "pnpm --filter @traceveil/web dev",
    "dev:services": "concurrently --names \"analysis,intel,takedown\" --prefix-colors \"green,yellow,magenta\" \"pnpm --filter @traceveil/analysis dev\" \"pnpm --filter @traceveil/intelligence dev\" \"pnpm --filter @traceveil/takedown dev\"",
    "dev:api": "pnpm --filter @traceveil/analysis dev",
    "dev:intel": "pnpm --filter @traceveil/intelligence dev",
    "dev:takedown": "pnpm --filter @traceveil/takedown dev",
    "build": "pnpm --filter @traceveil/web build",
    "start": "concurrently --names \"web,analysis,intel,takedown\" --prefix-colors \"blue,green,yellow,magenta\" \"pnpm --filter @traceveil/web start\" \"pnpm --filter @traceveil/analysis start\" \"pnpm --filter @traceveil/intelligence start\" \"pnpm --filter @traceveil/takedown start\"",
    "lint": "pnpm --filter @traceveil/web lint",
    "install:py": "node scripts/setup-python-venv.cjs",
    "dev:community": "pnpm --filter @traceveil/community dev",
    "test:community": "pnpm --filter @traceveil/community test"
  },
  "dependencies": {
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4"
  }
}
