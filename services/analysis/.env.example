# Copy to .env (local). On Render set these in the dashboard.
# Comma-separated origins allowed to call this API from the browser (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
# Hugging Face token (Read) for the deepfake model call
HF_TOKEN=
# Optional tuning
# TRACEVEIL_MAX_CONCURRENT_SCANS=2
# TRACEVEIL_MAX_CONCURRENT_VIDEO_SCANS=1
# TRACEVEIL_RETENTION_DAYS=7
# TRACEVEIL_DATA_DIR=/var/data
# DEEPFAKE_MODEL_ID=
