# Copy to .env. Nothing here is shared with apps/web or any other service.

NODE_ENV=development
COMMUNITY_PORT=8004

# Own PostgreSQL database (see docker-compose.yml, service community-db)
DATABASE_URL=postgresql://community:community_dev@localhost:5433/community

# Origins allowed to call this service with cookies (the web app)
ALLOWED_ORIGINS=http://localhost:3000

# Set to true behind HTTPS (production). Cookies are then Secure.
COOKIE_SECURE=false
# Set to true only when a trusted reverse proxy (Caddy) sits in front
TRUST_PROXY=false

# While false, members cannot post in chat rooms (Announcements and Quiet room stay readable).
COMMUNITY_OPEN=true

SESSION_DAYS=14
RETENTION_DAYS=30
RATE_LIMIT_ENABLED=true
# New sign-ups allowed per hour from one address. Raise it if an office or shelter helps several people at once.
REGISTER_LIMIT_PER_HOUR=5
